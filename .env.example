# Brighter API base URL
BRIGHTER_BASE_URL=https://brighter-kairatu-api.koffiesoft.com

# Brighter API credentials
BRIGHTER_USERNAME=
BRIGHTER_PASSWORD=
BRIGHTER_CLIENT_ID=
BRIGHTER_CLIENT_SECRET=

# Database connection (default: root@localhost/brighter_mirror)
BRIGHTER_DB_HOST=localhost
BRIGHTER_DB_PORT=3306
BRIGHTER_DB_USER=root
BRIGHTER_DB_PASSWORD=
BRIGHTER_DB_NAME=brighter_mirror

# csb_db target for sync_csb_produk.py (existing production DB - table structure
# is NOT managed by this tool, only INSERT/UPDATE on a whitelisted set of columns).
# Leave CSB_DB_HOST/USER/PASSWORD empty to reuse the BRIGHTER_DB_* connection
# (same MySQL server, different schema). Set them only if csb_db needs a
# different host or a separate, more restricted MySQL user/password.
CSB_DB_NAME=csb_db
CSB_DB_HOST=
CSB_DB_PORT=
CSB_DB_USER=
CSB_DB_PASSWORD=
