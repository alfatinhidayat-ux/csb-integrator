# =========================================================
# Konfigurasi koneksi database MySQL
# (samakan dengan .env yang dipakai sync_coretax.py)
# =========================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nama_database_anda

# Nama tabel hasil sync_coretax.py (default sudah sesuai dokumentasi)
TABLE_FAKTUR=coretax_faktur
TABLE_DETAIL=coretax_detail_faktur

# =========================================================
# NPWP Penjual (16 digit) -> dipakai sebagai <TIN> di root XML
# Kosongkan jika ingin diambil otomatis dari 16 digit pertama
# kolom "ID TKU Penjual"
# =========================================================
SELLER_NPWP=

# Folder output file XML
OUTPUT_DIR=output_xml
